{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "heart-islands",
  "main": "./server/worker.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
